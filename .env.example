# ---- FalkorDB (docker compose up -d starts it on these defaults) ----
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Host port for the FalkorDB Browser UI (docker compose)
FALKORDB_BROWSER_PORT=3000
# Graph name prefix: graphs are <prefix>prod_graph, <prefix>memory_graph, <prefix>sim_<incident>
AEGIS_GRAPH_PREFIX=aegis_

# ---- LLM (optional). Without a key the agent runs the same MCP tools in deterministic mode ----
# Provider: anthropic | openrouter (empty = whichever key is set; Anthropic wins if both are)
AEGIS_LLM_PROVIDER=
AEGIS_MAX_TOOL_ITERATIONS=25

# Option A - OpenRouter, free models only (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Primary model + comma-separated fallbacks, tried in order when a model errors or is rate limited.
# Only models OpenRouter prices at zero are accepted (IDs ending in :free, or openrouter/free).
AEGIS_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AEGIS_OPENROUTER_FALLBACKS=google/gemma-4-31b-it:free,openrouter/free
# Reasoning effort sent to the model: minimal | low | medium | high, or omit to send nothing
AEGIS_OPENROUTER_REASONING=medium

# Option B - Anthropic API
ANTHROPIC_API_KEY=
AEGIS_LLM_MODEL=claude-opus-5-5
AEGIS_LLM_EFFORT=high

# ---- Agent safety ----
# A passing sandbox simulation must exist within this window before execute_remediation is allowed
AEGIS_SIM_TTL_MINUTES=30
# Keep the sandbox graph after simulation so it can be inspected in the FalkorDB Browser (http://localhost:3000)
AEGIS_KEEP_SANDBOX=true

# ---- API / UI ----
AEGIS_API_PORT=8000
AEGIS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Also attach the official FalkorDB MCP server (mcp/falkordb-mcpserver) as a second MCP tool source
AEGIS_ENABLE_FALKORDB_MCP=false
# Local hashing embedding dimension (must match the vector index dimension)
AEGIS_EMBED_DIM=384
